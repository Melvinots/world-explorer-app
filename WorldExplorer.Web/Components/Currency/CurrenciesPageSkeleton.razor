<div class="skeleton-root" role="status" aria-busy="true" aria-live="polite">
    <span class="visually-hidden">Loading currencies…</span>

    <MudStack Spacing="6">

        @* Converter card *@
        <MudCard Class="skeleton-card" Elevation="0">
            <MudCardContent Class="pa-6">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="180px" Height="28px"
                             Class="skeleton-block mb-6" />

                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="3">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" Class="skeleton-field" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" Class="skeleton-field" />
                    </MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex align-center justify-center">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" Class="skeleton-field" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" Class="skeleton-field" />
                    </MudItem>
                </MudGrid>

                <MudPaper Class="skeleton-result mt-6 pa-6 d-flex flex-column align-center justify-center" Elevation="0">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="160px" Height="16px" Class="skeleton-block mb-3" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="220px" Height="48px" Class="skeleton-block mb-3" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="140px" Height="16px" Class="skeleton-block" />
                </MudPaper>
            </MudCardContent>
        </MudCard>

        @* Chart card *@
        <MudCard Class="skeleton-card" Elevation="0">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center" style="gap: 8px;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="140px" Height="22px" Class="skeleton-block" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="70px" Height="14px" Class="skeleton-block" />
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="px-4 pb-4 pt-0">
                <div class="skeleton-chart" aria-hidden="true">
                    @foreach (var height in _barHeights)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="@($"{height}%")"
                                     Class="skeleton-bar" />
                    }
                </div>
            </MudCardContent>
        </MudCard>

    </MudStack>
</div>

@code {
    // Rough rising-and-falling shape so the placeholder reads as a chart.
    private static readonly int[] _barHeights = { 38, 52, 46, 60, 55, 68, 62, 78, 72, 66, 84, 76 };
}
