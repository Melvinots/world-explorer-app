@if (_isVisible)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-container" @onclick:stopPropagation>

            @if (_isLoading)
            {
                <div class="modal-loading">
                    <div class="modal-spinner"></div>
                    <p>Loading details...</p>
                </div>
            }
            else if (_country is not null)
            {
                <div class="modal-header">
                    <div class="modal-flag">
                        @{
                            var flagUrl = !string.IsNullOrEmpty(_country.Flag.UrlSvg)
                                ? _country.Flag.UrlSvg
                                : _country.Flag.UrlPng;
                        }
                        @if (!string.IsNullOrEmpty(flagUrl))
                        {
                            <img src="@flagUrl"
                                 alt="@(string.IsNullOrEmpty(_country.Flag.Description) ? $"{_country.Names.Common} flag" : _country.Flag.Description)"
                                 loading="lazy"
                                 onerror="this.onerror=null; this.src='/images/flag-placeholder.png';" />
                        }
                        else if (!string.IsNullOrEmpty(_country.Flag.Emoji))
                        {
                            <span class="flag-emoji">@_country.Flag.Emoji</span>
                        }
                    </div>
                    <div class="modal-title-group">
                        <h2 class="modal-country-name">@_country.Names.Common</h2>
                        @if (!string.IsNullOrEmpty(_country.Descriptions.Short))
                        {
                            <p class="modal-official-name">@_country.Descriptions.Short</p>
                        }
                    </div>
                    <button class="modal-close" @onclick="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>

                <div class="modal-body">
                    <!-- Left column -->
                    <div class="modal-col">
                        <div class="modal-row">
                            <span class="modal-label">Capital</span>
                            <span class="modal-value">@(_country.Capitals.FirstOrDefault()?.Name ?? "N/A")</span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Region</span>
                            <span class="modal-value">@(string.IsNullOrEmpty(_country.Region) ? "N/A" : _country.Region)</span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Subregion</span>
                            <span class="modal-value">@(string.IsNullOrEmpty(_country.Subregion) ? "N/A" : _country.Subregion)</span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Population</span>
                            <span class="modal-value">@FormatHelper.FormatPopulation(_country.Population)</span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Area</span>
                            <span class="modal-value">@(_country.Area.Kilometers > 0 ? $"{_country.Area.Kilometers:N0} km²" : "N/A")</span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Government</span>
                            <span class="modal-value">@(string.IsNullOrEmpty(_country.GovernmentType) ? "N/A" : _country.GovernmentType)</span>
                        </div>
                    </div>

                    <!-- Right column -->
                    <div class="modal-col">
                        <div class="modal-row">
                            <span class="modal-label">Code</span>
                            <span class="modal-value">
                                @(string.IsNullOrEmpty(_country.Codes.Alpha2) ? "N/A" : $"{_country.Codes.Alpha2} / {_country.Codes.Alpha3}")
                            </span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Currencies</span>
                            <span class="modal-value">
                                @if (_country.Currencies.Count > 0)
                                {
                                    @string.Join(", ", _country.Currencies.Select(c =>
                                        string.IsNullOrEmpty(c.Symbol) ? c.Name : $"{c.Name} ({c.Symbol})"))
                                }
                                else
                                {
                                    @("N/A")
                                }
                            </span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Languages</span>
                            <span class="modal-value">
                                @if (_country.Languages.Count > 0)
                                {
                                    @string.Join(", ", _country.Languages.Select(l => l.Name))
                                }
                                else
                                {
                                    @("N/A")
                                }
                            </span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Driving side</span>
                            <span class="modal-value">
                                @(string.IsNullOrEmpty(_country.Cars.DrivingSide)
                                    ? "N/A"
                                    : char.ToUpper(_country.Cars.DrivingSide[0]) + _country.Cars.DrivingSide[1..])
                            </span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">UN Member</span>
                            <span class="modal-value">@(_country.Memberships.Un ? "Yes" : "No")</span>
                        </div>
                        <div class="modal-row">
                            <span class="modal-label">Flag</span>
                            <span class="modal-value flag-emoji">
                                @(string.IsNullOrEmpty(_country.Flag.Emoji) ? "N/A" : _country.Flag.Emoji)
                            </span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_country.Links.GoogleMaps))
                {
                    <div class="modal-footer">
                        <a href="@_country.Links.GoogleMaps" target="_blank" rel="noopener" class="maps-link">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
                                <circle cx="12" cy="9" r="2.5" />
                            </svg>
                            View on Google Maps
                        </a>
                    </div>
                }
            }
        </div>
    </div>
}